#!/usr/bin/env node
// build.mjs — slides/*.html → deck.pptx (editable PPTX)
// Wraps the slide bundle's export_deck_pptx.mjs.

import { spawn, spawnSync, execFileSync } from 'child_process';
import { existsSync } from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { prebuildSvg } from '../../.claude/skills/slide/scripts/prebuild-svg.mjs';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = path.resolve(__dirname, '../..');
const SKILL_DIR = path.resolve(REPO_ROOT, '.claude/skills/slide');
const SKILL_SCRIPT = path.join(SKILL_DIR, 'scripts/export_deck_pptx.mjs');
const VERIFY_SCRIPT = path.join(SKILL_DIR, 'scripts/verify_deck.py');

// Project lives at output/<name>-pptx/. Build artifact (.pptx) lands in the
// same folder alongside slides/, so each generation request stays self-contained.
const slidesDir = path.join(__dirname, 'slides');
const projectDirName = path.basename(__dirname);
const projectSlug = projectDirName.endsWith('-pptx')
  ? projectDirName.slice(0, -'-pptx'.length)
  : projectDirName;
const outFile = path.join(__dirname, `${projectSlug}.pptx`);

// slide-plan integration — systematic path: slide_plan.json present.
// Validate R2 (chart/table strategy ↔ takeaway pairing) and R5 (evidence
// mapping). exit 1 from validator → block the build. simple path skips.
const planPath = path.join(__dirname, 'slide_plan.json');
if (existsSync(planPath)) {
  console.log('[build] slide_plan.json detected → systematic path (R2/R5 validation)');
  try {
    execFileSync('python3', [
      path.join(REPO_ROOT, '.claude/skills/slide-plan/scripts/validate_plan.py'),
      planPath,
    ], { stdio: 'inherit' });
  } catch (e) {
    console.error('\n✗ slide_plan.json 검증 실패. /slide-plan을 다시 돌려 R2/R5를 충족하세요.');
    process.exit(1);
  }
} else {
  console.log('[build] slide_plan.json not present → simple path (no R2/R5 enforcement)');
}

// Diversity gate (HARD, --strict) — data-layout coverage / distinct count /
// card-type ratio / visual presence (registry: references/layouts.md). Promoted
// from WARN to hard-fail (Phase 4): every slide must tag <body data-layout>,
// and the deck must clear the distinct/card-ratio/visual floors before any
// Playwright work starts. Boilerplates ship pre-tagged, so a fresh init build
// passes. This is independent of the 4-constraints enforced in html2pptx.js.
try {
  execFileSync('node', [
    path.join(SKILL_DIR, 'scripts/validate-diversity.mjs'),
    '--slides', slidesDir, '--strict',
  ], { stdio: 'inherit' });
} catch (e) {
  console.error('\n✗ diversity gate failed — <body data-layout> 태깅/레이아웃 회전을 고치세요 (references/layouts.md).');
  process.exit(1);
}

// Design self-check gates (WARN) — B-r2/B-gm/B-density/B-plan-* heuristics
// (scripts/check_design_gates.py, extracted from SKILL.md Step 5 inline blocks).
// Warn-only: heuristic false-positives must never block a build, but /slide
// treats any FAIL line as must-fix before declaring the deck complete.
try {
  execFileSync('python3', [
    path.join(SKILL_DIR, 'scripts/check_design_gates.py'), __dirname,
  ], { stdio: 'inherit' });
} catch (e) {
  console.error('[build] design gates skipped (non-fatal):', e.message);
}

// Stale-hex guard (WARN) — hardcoded color hex in slides/ that doesn't match
// the active palette is likely left over from a prior theme (theme-init Fix1).
try {
  execFileSync('python3', [
    path.join(REPO_ROOT, '.claude/skills/theme-init/scripts/scan_stale_hex.py'),
    '--deck', projectDirName,
  ], { stdio: 'inherit' });
} catch (e) {
  console.error('[build] stale-hex guard skipped (non-fatal):', e.message);
}

// Prebuild: PptxGenJS embeds <img src="…svg"> as a fake .png that PowerPoint
// can't decode (chart shows as broken-image icon). Rasterize icons/*.svg to
// real PNG and rewrite slide HTML to point at the PNG. See E11 in
// .claude/skills/slide/references/error-patterns.md.
await prebuildSvg({ projectDir: __dirname });

// cwd=SKILL_DIR so Node module resolution finds the bundle's own node_modules
// when present (claude.ai deployment), and falls back up the tree to the repo
// root's node_modules for local use.
const child = spawn('node', [SKILL_SCRIPT, '--slides', slidesDir, '--out', outFile], {
  stdio: 'inherit',
  cwd: SKILL_DIR,
});

// Completion gate (mode-aware hard-fail). build.mjs and the AGENTS.md
// "verify-before-done" gate share ONE verification path: verify_deck.py.
// Claude-quality decks already pass; this only blocks shortcut/placeholder
// decks (image-flattened, dangling <img>, placeholder-only media, >=10 slides
// without a plan). See the Codex dual-host spec.
child.on('exit', code => {
  if (code) process.exit(code);
  if (existsSync(VERIFY_SCRIPT)) {
    const v = spawnSync('python3', [VERIFY_SCRIPT, __dirname], { stdio: 'inherit' });
    if (v.error) {
      // Fail CLOSED: a missing python3 (ENOENT) must not silently pass the gate.
      console.error('[build] verify_deck.py could not run (python3 missing?):', v.error.code);
      process.exit(1);
    }
    process.exit(v.status ?? 0);
  }
  process.exit(0);
});
